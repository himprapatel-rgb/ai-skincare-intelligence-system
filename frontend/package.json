{
  "name": "ai-skincare-intelligence-frontend",
  "version": "1.0.0",
  "description": "AI-powered skincare analysis frontend with React",
  "private": true,
  "scripts": {
    "build": "vite build",
    "build:tokens": "node src/tokens/build.js",
    "prebuild": "node src/tokens/build.js",
    "dev": "vite",
    "dev:mobile": "node scripts/open-mobile-browser.js --with-dev",
    "open:mobile": "node scripts/open-mobile-browser.js",
    "start": "node server.js",
    "lint": "eslint . --ext ts,tsx --report-unused-disable-directives --max-warnings 0",
    "typecheck": "tsc --noEmit",
    "preview": "vite preview",
    "test": "vitest",
    "test:ui": "vitest --ui",
    "coverage": "vitest run --coverage",
    "e2e": "playwright test",
    "e2e:agent": "AGENT_MOCK_API=true playwright test agent-gui",
    "e2e:human": "HUMAN_AGENT=true playwright test human-agent",
    "e2e:mobile-app": "playwright test task-10000-mobile-app",
    "e2e:settings-flows": "playwright test settings-device-flows",
    "generate-icons": "node scripts/generate-pwa-icons.js"
  },
  "dependencies": {
    "@mediapipe/tasks-vision": "^0.10.32",
    "@sentry/react": "^8.38.0",
    "@tanstack/react-query": "^5.95.2",
    "@tensorflow-models/blazeface": "^0.0.7",
    "@tensorflow/tfjs": "^4.22.0",
    "@tensorflow/tfjs-backend-webgl": "^4.22.0",
    "axios": "^1.6.2",
    "express": "^4.18.2",
    "html2canvas": "^1.4.1",
    "html5-qrcode": "^2.3.8",
    "jspdf": "^4.0.0",
    "lucide-react": "^0.562.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-router-dom": "^6.20.0",
    "react-webcam": "^7.2.0",
    "recharts": "^3.6.0",
    "serve": "^14.2.1",
    "three": "^0.182.0",
    "zustand": "^4.4.7"
  },
  "devDependencies": {
    "@fullhuman/postcss-purgecss": "^8.0.0",
    "@playwright/test": "^1.54.2",
    "@testing-library/jest-dom": "^6.1.5",
    "@testing-library/react": "^14.1.2",
    "@testing-library/user-event": "^14.5.1",
    "@types/react": "^18.2.43",
    "@types/react-dom": "^18.2.17",
    "@types/three": "^0.183.1",
    "@typescript-eslint/eslint-plugin": "^6.14.0",
    "@typescript-eslint/parser": "^6.14.0",
    "@vitejs/plugin-react": "^4.2.1",
    "@vitest/coverage-v8": "^1.0.4",
    "@vitest/ui": "^1.0.4",
    "dotenv": "^17.2.3",
    "eslint": "^8.55.0",
    "eslint-plugin-react-hooks": "^4.6.0",
    "eslint-plugin-react-refresh": "^0.4.5",
    "jsdom": "^24.0.0",
    "rollup-plugin-visualizer": "^6.0.5",
    "sharp": "^0.34.5",
    "typescript": "^5.2.2",
    "vite": "^5.0.8",
    "vite-plugin-svgr": "^4.5.0",
    "vitest": "^1.0.4"
  },
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=9.0.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/himprapatel-rgb/ai-skincare-intelligence-system"
  },
  "keywords": [
    "skincare",
    "ai",
    "react",
    "typescript",
    "vite"
  ],
  "author": "himprapatel-rgb",
  "license": "MIT"
}
