{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(cd backend && python -m pytest *)",
      "Bash(cd frontend && npm test)",
      "Bash(cd frontend && npm run build)",
      "Bash(cd frontend && npx tsc --noEmit)",
      "Bash(cd frontend && npm install *)",
      "Bash(cd backend && pip install *)",
      "Bash(git add *)",
      "Bash(git commit *)",
      "Bash(git push *)",
      "Bash(git status*)",
      "Bash(git diff*)",
      "Bash(git log*)",
      "Bash(uvicorn *)"
    ],
    "deny": [
      "Bash(rm -rf /)",
      "Bash(rm -rf .git)",
      "Bash(sudo *)",
      "Edit(.env*)",
      "Edit(**/credentials*)",
      "Edit(**/secrets*)"
    ]
  }
}
